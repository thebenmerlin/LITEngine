# Hugging Face API Configuration
HUGGINGFACE_API_KEY=hf_your_api_key_here

# Kanoon (Indian Legal Database) Configuration
KANOON_BASE_URL=https://indiankanoon.org

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Server Configuration
PORT=8000

# Environment (development | production)
ENV=development

# Fixtures (set to true for offline dev with sample data)
USE_FIXTURES=false

# Logging Level
LOG_LEVEL=INFO

# Cache TTL in seconds
CACHE_TTL=3600

# Which judicial-outcome prediction populates the top-level simulation
# result: "new_model" (trained classifier) or "old_heuristic" (hand-picked
# weights). Auto-falls-back to old_heuristic if the trained model can't
# load, regardless of this setting. Flip for a fast, code-free revert.
OUTCOME_MODEL_PRIMARY=new_model

# Leave empty to use the checked-in incumbent binary model. Set only after
# the filing-based model passes its holdout gate.
OUTCOME_MODEL_PATH=

# Optional frozen, dated precedent index. Oracle staging mounts this at
# /data/precedent_index.json; the checked-in fixture is otherwise used.
PRECEDENT_INDEX_PATH=
